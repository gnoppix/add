[Unit]
Description=Add Relay / Mailbox Server (asia / root@sg)
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
# State dir (/root/.add) is mounted tmpfs by systemd-tmpfiles via add-tmpfs.conf.
Requires=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/add
# Behind nginx: bind loopback + let nginx terminate TLS on :443.
# --url advertises the public wss endpoint; --bootstrap points at the
# region DHT(s) this relay proxies lookups through.
ExecStart=/root/add/add-relay \
  --host 127.0.0.1 \
  --port 8765 \
  --url wss://relay-asia.gnoppix.org/ws \
  --bootstrap wss://bootstrap-asia.gnoppix.org/ws \
  --bootstrap wss://bootstrap-eu.gnoppix.org/ws \
  --bootstrap wss://bootstrap-us.gnoppix.org/ws
# Enforce ephemeral (tmpfs) state dir: the daemon panics at boot if /root/.add
# is not tmpfs. Paired with deploy/systemd/add-tmpfs.conf.
Environment=ADD_REQUIRE_TMPFS=0
Restart=on-failure
RestartSec=3

# --- snapshot / forensics hardening ---
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
CapabilityBoundingSet=CAP_IPC_LOCK
AmbientCapabilities=CAP_IPC_LOCK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=true
# State dir (no tmpfs, per operator request): allow daemon to persist DHT/relay DB.
ReadWritePaths=/root/.add

[Install]
WantedBy=multi-user.target
